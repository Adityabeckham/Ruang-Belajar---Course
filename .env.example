# ── Frontend (.env.local) ──────────────────────────────────────────────
# URL deployment Convex (otomatis di-set oleh `npx convex dev`).
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# ── Convex deployment env (set via `npx convex env set <NAME> <VALUE>`) ──
# Bukan di file ini — ini cuma daftar yang wajib ada di deployment.
#
# OAuth GitHub  → https://github.com/settings/developers
#   Authorization callback URL: <CONVEX_SITE_URL>/api/auth/callback/github
# AUTH_GITHUB_ID=...
# AUTH_GITHUB_SECRET=...
#
# OAuth Google  → https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: <CONVEX_SITE_URL>/api/auth/callback/google
# AUTH_GOOGLE_ID=...
# AUTH_GOOGLE_SECRET=...
#
# Origin frontend untuk redirect setelah login (mis. http://localhost:5173)
# SITE_URL=http://localhost:5173
#
# JWT keys Convex Auth di-generate otomatis oleh `npx @convex-dev/auth`
# (mengisi JWT_PRIVATE_KEY & JWKS di deployment).
