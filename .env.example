# ─────────────────────────────────────────────────────────────
# Ruang Belajar LMS — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git!
#
# For Convex deployment env vars, use:
#   npx convex env set AUTH_GITHUB_ID <value>
# ─────────────────────────────────────────────────────────────

# GitHub OAuth App credentials
# Create at: https://github.com/settings/developers → OAuth Apps → New
# Callback URL: <YOUR_CONVEX_SITE_URL>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth Client credentials
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <YOUR_CONVEX_SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
